# Variables d'environnement de Siira
#
# Copiez ce fichier en `.env.local` (non versionné) et renseignez les valeurs.
# En Phase 1 (frontend seul), une seule est utile, et elle est facultative :
# `NEXT_PUBLIC_ESPACE`. Les autres servent à la Phase 2.

# --- Espace servi par cette adresse ---
# Facultatif. Valeurs possibles : agent, centre, ong.
# Laissée vide, l'adresse sert l'application complète, les quatre rôles compris :
# c'est l'adresse de démonstration.
# Exemple : NEXT_PUBLIC_ESPACE=agent
NEXT_PUBLIC_ESPACE=

# --- Supabase (Phase 2) ---
# Visibles par le navigateur : ces deux valeurs sont publiques par conception,
# la sécurité repose sur les politiques RLS de la base.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de service : SERVEUR UNIQUEMENT. Contourne les politiques RLS.
# Ne jamais la préfixer par NEXT_PUBLIC_, ne jamais la versionner.
SUPABASE_SERVICE_ROLE_KEY=

# --- DeepSeek (Phase 2) ---
# SERVEUR UNIQUEMENT, utilisée dans les routes API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
